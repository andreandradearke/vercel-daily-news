# Vercel Daily News - Environment Variables Sample
# Copy this file to .env.local and customize as needed
# All variables are optional - defaults are set in config files

# =============================================================================
# SEARCH CONFIGURATION (Client-side - requires NEXT_PUBLIC_ prefix)
# =============================================================================

# Maximum number of search results to return
# Default: 5
NEXT_PUBLIC_SEARCH_LIMIT=5

# Minimum number of characters before triggering auto-search
# Default: 3
NEXT_PUBLIC_SEARCH_MIN_LENGTH=3

# Debounce delay in milliseconds before executing search
# Prevents excessive API calls while user is typing
# Default: 500
NEXT_PUBLIC_SEARCH_DEBOUNCE_MS=500

# =============================================================================
# CACHE CONFIGURATION (Server-side - no NEXT_PUBLIC_ prefix)
# =============================================================================

# -----------------------------------------------------------------------------
# ISR Revalidation Times (seconds)
# How often Next.js regenerates cached pages
# -----------------------------------------------------------------------------

# Individual article pages (how often articles are refreshed)
# Default: 3600 (1 hour)
CACHE_REVALIDATE_ARTICLES_INDIVIDUAL=3600

# Article lists (homepage, featured articles)
# Default: 300 (5 minutes)
CACHE_REVALIDATE_ARTICLES_LIST=300

# Article search results (needs fresher data than static lists)
# Default: 60 (1 minute)
CACHE_REVALIDATE_ARTICLES_SEARCH=60

# Breaking news banner
# Default: 300 (5 minutes)
CACHE_REVALIDATE_BREAKING_NEWS=300

# Categories list (changes infrequently)
# Default: 3600 (1 hour)
CACHE_REVALIDATE_CATEGORIES=3600

# -----------------------------------------------------------------------------
# CDN Cache-Control Stale-While-Revalidate Times (seconds)
# How long CDN serves stale content while fetching fresh data in background
# -----------------------------------------------------------------------------

# Individual articles stale window
# Default: 7200 (2 hours)
CACHE_STALE_ARTICLES=7200

# Article lists and search results stale window
# Default: 600 (10 minutes)
CACHE_STALE_LISTS=600

# Breaking news stale window
# Default: 600 (10 minutes)
CACHE_STALE_BREAKING_NEWS=600

# Categories stale window
# Default: 7200 (2 hours)
CACHE_STALE_CATEGORIES=7200